{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [       
        {
            "name": "C#: UnderdogAPI Debug (coreclr fallback)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build UnderdogAPI",
            "program": "${workspaceFolder}/Underdog.API/bin/Debug/net10.0/Underdog.API.dll",
            "cwd": "${workspaceFolder}/Underdog.API",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }

    ]
}